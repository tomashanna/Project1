# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment, used in invitation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated break-glass admin emails (must be confirmed).
# Admins are normally defined by profiles.role = 'admin'.
ADMIN_EMAILS=

# "Depurar con IA" pipeline
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
